# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api
APP_PUBLIC_URL=http://localhost:5173

# CORS Allowed Origins (comma-separated or single URL)
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:root@localhost:5432/billpos?schema=public"

# Root Superadmin Initial Provisioning (Bootstrap Configuration)
ROOT_SUPERADMIN_PHONE="+918380989776"
ROOT_SUPERADMIN_EMAIL="superadmin@billingbuddy.com"
# ROOT_SUPERADMIN_INITIAL_PASSWORD= (Provide securely via environment; do NOT commit secrets to Git)

# Cryptographic Keys (AES-256-GCM TOTP Secret Encryption at Rest)
# Mandatory: Generate a fresh 32-byte key (64 hex characters) using: openssl rand -hex 32
# DO NOT COMMIT OPERATIONAL OR PRODUCTION KEYS TO GIT.
TOTP_ENCRYPTION_KEY="replace_with_64_hex_character_secret_key_generated_via_openssl"
